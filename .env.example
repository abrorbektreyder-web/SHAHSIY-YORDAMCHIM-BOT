BOT_TOKEN=123456:ABC-DEF
OWNER_ID=123456789
DATABASE_URL=postgresql://postgres.xxx:PAROL@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DB_SCHEMA=vazifa
MODE=polling

# AI provayderlari: groq (bepul) yoki openrouter (pullik)
LLM_PROVIDER=groq
STT_PROVIDER=groq
# Bo'sh qolsa: groq → qwen/qwen3.8-27b, openrouter → google/gemini-3.5-flash-lite
LLM_MODEL=
GROQ_API_KEY=gsk_...
# Ixtiyoriy: bo'sh qolsa bot ovozli javob bermaydi, faqat matn yozadi
OPENROUTER_API_KEY=
# Ixtiyoriy: internetdan qidirish (tavily.com, bepul oyiga 1000 qidiruv)
TAVILY_API_KEY=

# Render o'zi RENDER_EXTERNAL_URL beradi; lokal webhook sinovi uchungina kerak:
# WEBHOOK_BASE_URL=https://vazifa-bot.onrender.com
# WEBHOOK_SECRET=
# PORT=8080
# Faqat db integratsiya testlari uchun (ixtiyoriy):
# TEST_DATABASE_URL=
